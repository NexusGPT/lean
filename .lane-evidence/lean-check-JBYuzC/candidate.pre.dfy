// PRELUDE Option
datatype Option<T> = None | Some(value: T)
// END PRELUDE
// PRELUDE Ref
type Ref = nat
// END PRELUDE
// PRELUDE Obj
datatype Obj = Dead
// END PRELUDE
// PRELUDE HWorld
datatype HWorld = HWorld(heap: map<Ref, Obj>, next: nat, oob: bool)
// END PRELUDE
// PRELUDE Pres
datatype Pres<T> = PMissing | PUndef | PVal(pv: T)
// END PRELUDE
// PRELUDE PresOpt
function PresOpt<T>(x: Pres<T>): Option<T> { match x case PVal(v) => Option.Some(v) case _ => Option.None }
// END PRELUDE
// PRELUDE OptPres
function OptPres<T>(o: Option<T>): Pres<T> { match o case Some(v) => PVal(v) case None => PUndef }
// END PRELUDE
// PRELUDE OptOr
function OptOr<T>(o: Option<T>, d: T): T { match o case Some(v) => v case None => d }
// END PRELUDE
// PRELUDE OptOrOpt
function OptOrOpt<T>(a: Option<T>, b: Option<T>): Option<T> { if a.Some? then a else b }
// END PRELUDE
// PRELUDE OptMark
function OptMark<T>(hw: HWorld, o: Option<T>): HWorld { if o.Some? then hw else hw.(oob := true) }
// END PRELUDE
// PRELUDE WFCell
predicate WFCell(hw: HWorld, o: Obj) { match o  case Dead => false }
// END PRELUDE
// PRELUDE WF
predicate WF(hw: HWorld) { !hw.oob && (forall r :: r in hw.heap ==> r < hw.next) && (forall r :: r in hw.heap ==> WFCell(hw, hw.heap[r])) }
// END PRELUDE
// PRELUDE 16rx6rp
// CANON fuel=CanonOrder,CanonRootEdges,CanonCells,CanonIndex,CanonNames
// END PRELUDE
// PRELUDE CObj
datatype CObj = CDead
// END PRELUDE
// PRELUDE CanonEdges
function CanonEdges(o: Obj): seq<Ref> { match o  case Dead => [] }
// END PRELUDE
// PRELUDE CanonRecord
predicate CanonRecord(o: Obj) { false }
// END PRELUDE
// PRELUDE CanonLive
predicate CanonLive(hw: HWorld, r: Ref) { r in hw.heap && !hw.heap[r].Dead? }
// END PRELUDE
// PRELUDE CanonOrder
function CanonOrder(hw: HWorld, next0: nat, work: seq<Ref>, seen: set<Ref>, order: seq<Ref>): seq<Ref>
  decreases hw.heap.Keys - seen, |work|
{
  if |work| == 0 then order
  else var r := work[0];
    if r in seen || r < next0 || !CanonLive(hw, r) then CanonOrder(hw, next0, work[1..], seen, order)
    else CanonOrder(hw, next0, work[1..] + CanonEdges(hw.heap[r]), seen + {r}, order + [r])
}
// END PRELUDE
// PRELUDE CanonRootEdges
function CanonRootEdges(hw: HWorld, next0: nat, roots: seq<Ref>): seq<Ref> decreases |roots| { if |roots| == 0 then [] else (if roots[0] < next0 && CanonLive(hw, roots[0]) && CanonRecord(hw.heap[roots[0]]) then CanonEdges(hw.heap[roots[0]]) else []) + CanonRootEdges(hw, next0, roots[1..]) }
// END PRELUDE
// PRELUDE CanonOrderOf
function CanonOrderOf(hw: HWorld, next0: nat, roots: seq<Ref>): seq<Ref> { CanonOrder(hw, next0, roots + CanonRootEdges(hw, next0, roots), {}, []) }
// END PRELUDE
// PRELUDE CanonIndex
function CanonIndex(order: seq<Ref>, r: Ref): nat decreases |order| { if |order| == 0 then 0 else if order[0] == r then 0 else 1 + CanonIndex(order[1..], r) }
// END PRELUDE
// PRELUDE CanonName
function CanonName(next0: nat, order: seq<Ref>, r: Ref): nat { if r < next0 then r else next0 + CanonIndex(order, r) }
// END PRELUDE
// PRELUDE CanonNames
function CanonNames(next0: nat, order: seq<Ref>, rs: seq<Ref>): seq<nat> decreases |rs| { if |rs| == 0 then [] else [CanonName(next0, order, rs[0])] + CanonNames(next0, order, rs[1..]) }
// END PRELUDE
// PRELUDE CanonObj
function CanonObj(next0: nat, order: seq<Ref>, o: Obj): CObj { match o  case Dead => CDead }
// END PRELUDE
// PRELUDE CanonCells
function CanonCells(hw: HWorld, next0: nat, order: seq<Ref>, i: nat): seq<CObj> decreases |order| - i { if i >= |order| then [] else [if CanonLive(hw, order[i]) then CanonObj(next0, order, hw.heap[order[i]]) else CDead] + CanonCells(hw, next0, order, i + 1) }
// END PRELUDE
// PRELUDE CanonNamed
predicate CanonNamed(next0: nat, order: seq<Ref>, rs: seq<Ref>) { forall i :: 0 <= i < |rs| ==> rs[i] < next0 || rs[i] in order }
// END PRELUDE
// PRELUDE CanonNoUnnamed
predicate CanonNoUnnamed(hw0: HWorld, hw: HWorld, next0: nat, order: seq<Ref>) { (forall r :: r in hw.heap && r < next0 && (r !in hw0.heap || hw.heap[r] != hw0.heap[r]) ==> CanonNamed(next0, order, CanonEdges(hw.heap[r]))) && (forall i :: 0 <= i < |order| && order[i] in hw.heap ==> CanonNamed(next0, order, CanonEdges(hw.heap[order[i]]))) }
// END PRELUDE
// PRELUDE CanonInitial
predicate CanonInitial(next0: nat, hp: HWorld, op: seq<Ref>, hc: HWorld, oc: seq<Ref>) { forall r :: 0 <= r < next0 ==> ((r in hp.heap) <==> (r in hc.heap)) && (r in hp.heap && r in hc.heap ==> hp.heap[r] == hc.heap[r] || CanonObj(next0, op, hp.heap[r]) == CanonObj(next0, oc, hc.heap[r])) }
// END PRELUDE
// PRELUDE CanonEqual
predicate CanonEqual(hw0: HWorld, next0: nat, hp: HWorld, rootsP: seq<Ref>, hc: HWorld, rootsC: seq<Ref>)
{
  && CanonInitial(next0, hp, CanonOrderOf(hp, next0, rootsP), hc, CanonOrderOf(hc, next0, rootsC))
  && CanonCells(hp, next0, CanonOrderOf(hp, next0, rootsP), 0) == CanonCells(hc, next0, CanonOrderOf(hc, next0, rootsC), 0)
  && CanonNames(next0, CanonOrderOf(hp, next0, rootsP), rootsP) == CanonNames(next0, CanonOrderOf(hc, next0, rootsC), rootsC)
  && CanonNoUnnamed(hw0, hp, next0, CanonOrderOf(hp, next0, rootsP)) && CanonNoUnnamed(hw0, hc, next0, CanonOrderOf(hc, next0, rootsC))
}
// END PRELUDE
