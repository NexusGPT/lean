// Generated by lsc from x.ts

datatype Option<T> = None | Some(value: T)

datatype Opts = Opts(limit: Option<int>, step: Option<int>, strict: bool)

function reach(o: Opts): int
{
  var limit := o.limit;
  var step := o.step;
  var strict := o.strict;
  if strict then
    limit
  else
    (limit + step)
}

function limitOf(limit: int, strict: bool): int
{
  (reach(Opts(Some(limit), None, strict)) + reach(Opts(None, None, false)))
}
