// Generated by lsc from x.ts

method sumOfPositives(xs: seq<int>) returns (res: int)
{
  var positives := Std.Collections.Seq.Filter((x: int) => (x > 0), xs);
  var total := 0;
  var i_x_idx := 0;
  while i_x_idx < |positives|
    invariant (i_x_idx <= |positives|)
  {
    var x := positives[i_x_idx];
    total := (total + x);
    i_x_idx := i_x_idx + 1;
  }
  return total;
}
