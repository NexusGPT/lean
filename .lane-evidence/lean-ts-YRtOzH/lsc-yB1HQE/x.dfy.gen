// Generated by lsc from x.ts

method sumEvenIndices(xs: seq<int>) returns (res: int)
{
  var total := 0;
  var i := 0;
  while (i < |xs|)
  {
    total := (total + xs[i]);
    i := (i + 2);
  }
  return total;
}

method countDown(n: int) returns (res: int)
{
  var acc := 0;
  var i := n;
  while (i > 0)
  {
    acc := (acc + i);
    i := (i - 1);
  }
  return acc;
}
