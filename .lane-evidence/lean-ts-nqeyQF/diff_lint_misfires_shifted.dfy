  else
    flat;
  var sum: int := 0;
  var sum := rebound_loop1(flat, 0, sum);
  (((|flat| * 100) + sum) + |merged|)
}

function widest(xs: seq<int>): int
{
  var a: int := if |xs| != 0 then MaxSeq_int(Map_int_int(xs, ((x: int) => x * 2))) else 0;
  var b: int := if |xs| > 0 then MinSeq_int(xs) - 3 else 0;
  var c: int := if !(|xs| != 0) then 0 else MaxSeq_int(xs);
  if |xs| == 0 then
    ((a + b) + c)
  else
    (((a + b) + c) + MaxSeq_int(xs))
}

