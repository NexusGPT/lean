// PRELUDE Filter_int
function Filter_int(s: seq<int>, p: int -> bool): (r: seq<int>)
  ensures |r| <= |s|
  ensures forall i :: 0 <= i < |r| ==> p(r[i])
  decreases |s|
{ if |s| == 0 then [] else (if p(s[0]) then [s[0]] else []) + Filter_int(s[1..], p) }
// two predicates that agree on every element keep the same elements (the theorem states it where both sides filter)
lemma Filter_int_same(s: seq<int>, p: int -> bool, q: int -> bool)
  requires forall i :: 0 <= i < |s| ==> p(s[i]) == q(s[i])
  ensures Filter_int(s, p) == Filter_int(s, q)
  decreases |s|
{ if |s| > 0 { Filter_int_same(s[1..], p, q); } }
// END PRELUDE
// PRELUDE TruncDiv_int
function TruncDiv_int(a: int, b: int): int
  requires b != 0
{ var q := (if a >= 0 then a else -a) / (if b >= 0 then b else -b); if (a >= 0) == (b >= 0) then q else -q }
// END PRELUDE
// PRELUDE JsRem_int
function JsRem_int(a: int, b: int): int
  requires b != 0
{ a - b * TruncDiv_int(a, b) }
