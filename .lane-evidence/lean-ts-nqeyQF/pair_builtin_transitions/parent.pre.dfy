// PRELUDE CanonEqual
predicate CanonEqual(hw0: HWorld, next0: nat, hp: HWorld, rootsP: seq<Ref>, hc: HWorld, rootsC: seq<Ref>)
{
  && CanonInitial(next0, hp, CanonOrderOf(hp, next0, rootsP), hc, CanonOrderOf(hc, next0, rootsC))
  && CanonCells(hp, next0, CanonOrderOf(hp, next0, rootsP), 0) == CanonCells(hc, next0, CanonOrderOf(hc, next0, rootsC), 0)
  && CanonNames(next0, CanonOrderOf(hp, next0, rootsP), rootsP) == CanonNames(next0, CanonOrderOf(hc, next0, rootsC), rootsC)
  && CanonNoUnnamed(hw0, hp, next0, CanonOrderOf(hp, next0, rootsP)) && CanonNoUnnamed(hw0, hc, next0, CanonOrderOf(hc, next0, rootsC))
}
