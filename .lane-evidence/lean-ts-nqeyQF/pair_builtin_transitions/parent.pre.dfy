// PRELUDE CanonEdges
function CanonEdges(o: Obj): seq<Ref> { match o case A_int(p0) => [] case Dead => [] }
// END PRELUDE
// PRELUDE CanonRecord
predicate CanonRecord(o: Obj) { false }
// END PRELUDE
// PRELUDE CanonLive
predicate CanonLive(hw: HWorld, r: Ref) { r in hw.heap && !hw.heap[r].Dead? }
// END PRELUDE
// PRELUDE CanonOrder
function CanonOrder(hw: HWorld, next0: nat, work: seq<Ref>, seen: set<Ref>, order: seq<Ref>): seq<Ref>
  decreases hw.heap.Keys - seen, |work|
{
  if |work| == 0 then order
  else var r := work[0];
    if r in seen || r < next0 || !CanonLive(hw, r) then CanonOrder(hw, next0, work[1..], seen, order)
    else CanonOrder(hw, next0, work[1..] + CanonEdges(hw.heap[r]), seen + {r}, order + [r])
}
// END PRELUDE
// PRELUDE CanonRootEdges
function CanonRootEdges(hw: HWorld, next0: nat, roots: seq<Ref>): seq<Ref> decreases |roots| { if |roots| == 0 then [] else (if roots[0] < next0 && CanonLive(hw, roots[0]) && CanonRecord(hw.heap[roots[0]]) then CanonEdges(hw.heap[roots[0]]) else []) + CanonRootEdges(hw, next0, roots[1..]) }
// END PRELUDE
// PRELUDE CanonOrderOf
function CanonOrderOf(hw: HWorld, next0: nat, roots: seq<Ref>): seq<Ref> { CanonOrder(hw, next0, roots + CanonRootEdges(hw, next0, roots), {}, []) }
// END PRELUDE
// PRELUDE CanonIndex
function CanonIndex(order: seq<Ref>, r: Ref): nat decreases |order| { if |order| == 0 then 0 else if order[0] == r then 0 else 1 + CanonIndex(order[1..], r) }
// END PRELUDE
// PRELUDE CanonName
function CanonName(next0: nat, order: seq<Ref>, r: Ref): nat { if r < next0 then r else next0 + CanonIndex(order, r) }
// END PRELUDE
// PRELUDE CanonNames
function CanonNames(next0: nat, order: seq<Ref>, rs: seq<Ref>): seq<nat> decreases |rs| { if |rs| == 0 then [] else [CanonName(next0, order, rs[0])] + CanonNames(next0, order, rs[1..]) }
// END PRELUDE
// PRELUDE CanonObj
function CanonObj(next0: nat, order: seq<Ref>, o: Obj): CObj { match o case A_int(p0) => CA_int(p0) case Dead => CDead }
// END PRELUDE
// PRELUDE CanonCells
function CanonCells(hw: HWorld, next0: nat, order: seq<Ref>, i: nat): seq<CObj> decreases |order| - i { if i >= |order| then [] else [if CanonLive(hw, order[i]) then CanonObj(next0, order, hw.heap[order[i]]) else CDead] + CanonCells(hw, next0, order, i + 1) }
// END PRELUDE
// PRELUDE CanonNamed
predicate CanonNamed(next0: nat, order: seq<Ref>, rs: seq<Ref>) { forall i :: 0 <= i < |rs| ==> rs[i] < next0 || rs[i] in order }
// END PRELUDE
// PRELUDE CanonNoUnnamed
predicate CanonNoUnnamed(hw0: HWorld, hw: HWorld, next0: nat, order: seq<Ref>) { (forall r :: r in hw.heap && r < next0 && (r !in hw0.heap || hw.heap[r] != hw0.heap[r]) ==> CanonNamed(next0, order, CanonEdges(hw.heap[r]))) && (forall i :: 0 <= i < |order| && order[i] in hw.heap ==> CanonNamed(next0, order, CanonEdges(hw.heap[order[i]]))) }
// END PRELUDE
// PRELUDE CanonInitial
predicate CanonInitial(next0: nat, hp: HWorld, op: seq<Ref>, hc: HWorld, oc: seq<Ref>) { forall r :: 0 <= r < next0 ==> ((r in hp.heap) <==> (r in hc.heap)) && (r in hp.heap && r in hc.heap ==> hp.heap[r] == hc.heap[r] || CanonObj(next0, op, hp.heap[r]) == CanonObj(next0, oc, hc.heap[r])) }
