// Generated by lsc from x.ts

function pad(s: string, width: int, fill: string): string
{
  if (|s| >= width) then
    s
  else
    ((s + fill) + fill)
}

function padAll(xs: seq<string>): seq<string>
{
  seq(|xs|, i_map requires 0 <= i_map < |xs| => var x := xs[i_map]; pad(x, 4))
}

method widths(xs: seq<string>) returns (res: int)
{
  var total := 0;
  var i_x_idx := 0;
  while i_x_idx < |padAll(xs)|
    invariant (i_x_idx <= |padAll(xs)|)
  {
    var x := padAll(xs)[i_x_idx];
    total := (total + |x|);
    i_x_idx := i_x_idx + 1;
  }
  return total;
}
