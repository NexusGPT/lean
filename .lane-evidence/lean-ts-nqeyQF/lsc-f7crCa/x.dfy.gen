// Generated by lsc from x.ts

method sumPositive(xs: seq<int>) returns (res: int)
{
  var total := 0;
  var i_x_idx := 0;
  while i_x_idx < |xs|
    invariant (i_x_idx <= |xs|)
  {
    var x := xs[i_x_idx];
    if (x > 0) {
      total := (total + x);
    }
    i_x_idx := i_x_idx + 1;
  }
  return total;
}
